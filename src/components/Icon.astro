---
// Functional line icons only (concept: 1.5px graphite, no decorative icons). Decorative by default: the control carries the name.
type Name = "phone" | "viber" | "mail" | "map" | "menu" | "close" | "chevron" | "copy";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M6.6 3.5h2.6l1.4 4-2 1.4a11 11 0 0 0 6.5 6.5l1.4-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === "viber" && (
    <>
      <path d="M12 2.8c5 0 8.4 2.3 8.4 7.6 0 5.2-3.4 7.4-8.4 7.4-.8 0-1.6-.1-2.3-.2L6.4 20.6v-3.9C4.4 15.4 3.6 13.3 3.6 10.4 3.6 5.1 7 2.8 12 2.8Z" />
      <path d="M9.3 7.4h1.3l.7 1.9-.9.7a5 5 0 0 0 2.6 2.6l.7-.9 1.9.7v1.3c0 .5-.4.9-.9.9a6.3 6.3 0 0 1-6.3-6.3c0-.5.4-.9.9-.9Z" />
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5.5" width="18" height="13" rx="1" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </>
  )}
  {name === "map" && (
    <>
      <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "chevron" && <path d="m7 10 5 5 5-5" />}
  {name === "copy" && (
    <>
      <rect x="8.5" y="8.5" width="11" height="11" rx="1" />
      <path d="M15.5 5.5v-1a1 1 0 0 0-1-1h-9a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h1" />
    </>
  )}
</svg>
